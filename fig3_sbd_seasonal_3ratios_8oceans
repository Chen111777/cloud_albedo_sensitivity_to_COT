def load_ceres_ebaf_grid():
    """Calculate monthly CERES-EBAF Ac from CERES TOA fluxes and CERES cloud fraction.
    Ac = [SW_all - (1-CF)*SW_clear] / (CF * incoming solar flux).
    Both the fluxes and the cloud area fraction (CF, in percent -> fraction)
    are read directly from CERES_FILE, so no MODIS regridding is involved.
    """
    ds = xr.open_dataset(CERES_FILE)
    cf = ds["cldarea_total_daynight_mon"] / 100.0
    ac = (
        ds["toa_sw_all_mon"] - (1.0 - cf) * ds["toa_sw_clr_c_mon"]
    ) / cf / ds["solar_mon"]
    ac = ac.where((cf > 0) & np.isfinite(ac) & (ac >= 0) & (ac <= 1))
    result = ac.load()
    ds.close()
    return result
def ceres_ssf_albedo(data):
    """CERES-SSF Ac of the L3 samples (the 'albedo' of fig1_fitting_8oceans.py).
    Ac = [SW_all - (1-CF)*SW_clear] / (CF * incoming solar flux), evaluated
    sample by sample from the CERES SSF fluxes and cloud fraction stored in
    L3_product. No cloud-phase or cloud-top-temperature screening is applied;
    samples with CF <= 0 or Ac outside [0, 1] are returned as NaN.
    """
    required = {"sw_all", "sw_clr", "cf_ceres", "solar_incoming"}
    missing = required.difference(data.columns)
    if missing:
        raise ValueError(
            f"CERES-SSF Ac requires the L3 columns {sorted(missing)}, "
            f"available: {list(data.columns)}"
        )
    cf = pd.to_numeric(data["cf_ceres"], errors="coerce")
    sw_all = pd.to_numeric(data["sw_all"], errors="coerce")
    sw_clr = pd.to_numeric(data["sw_clr"], errors="coerce")
    solar = pd.to_numeric(data["solar_incoming"], errors="coerce")
    ac = (sw_all - (1.0 - cf) * sw_clr) / cf / solar
    ac = ac.where((cf > 0) & np.isfinite(ac) & (ac >= 0) & (ac <= 1))
    return ac.to_numpy(dtype=float)
def _find_column(data, candidates, description):
    lower = {str(c).lower(): c for c in data.columns}
    for name in candidates:
        if name.lower() in lower:
            return lower[name.lower()]
    raise ValueError(
        f"CERES-EBAF seasonal/regional matching requires a {description} column. "
        f"Accepted names: {candidates}. Available columns: {list(data.columns)}"
    )
def match_ceres_ebaf_to_l3(data, ceres_ebaf_grid, season):
    """Match CERES-EBAF Ac to L3 samples using latitude/longitude.
    If the L3 CSV has a month/time column, use month-specific CERES-EBAF Ac.
    Otherwise, use the seasonal mean of the relevant CERES months.
    """
    lat_col = _find_column(data, ["lat", "latitude"], "latitude")
    lon_col = _find_column(data, ["lon", "longitude"], "longitude")
    lower = {str(c).lower(): c for c in data.columns}
    month_col = next(
        (lower[name] for name in ["month", "time", "date", "year_month", "yyyymm"] if name in lower),
        None,
    )
    lat = pd.to_numeric(data[lat_col], errors="coerce").to_numpy(float)
    lon = pd.to_numeric(data[lon_col], errors="coerce").to_numpy(float)
    lon = ((lon + 180.0) % 360.0) - 180.0
    grid_lat = np.asarray(ceres_ebaf_grid.lat, dtype=float)
    grid_lon = ((np.asarray(ceres_ebaf_grid.lon, dtype=float) + 180.0) % 360.0) - 180.0
    lat_idx = np.abs(lat[:, None] - grid_lat[None, :]).argmin(axis=1)
    lon_idx = np.abs(lon[:, None] - grid_lon[None, :]).argmin(axis=1)
    ac_values = np.asarray(ceres_ebaf_grid.values)
    if month_col is None:
        season_months = {
            "MAM": [3, 4, 5],
            "JJA": [6, 7, 8],
            "SON": [9, 10, 11],
            "DJF": [12, 1, 2],
        }[season]
        time_months = pd.to_datetime(ceres_ebaf_grid.time.values).month
        month_indices = np.flatnonzero(np.isin(time_months, season_months))
        seasonal_grid = np.nanmean(ac_values[month_indices, :, :], axis=0)
        return seasonal_grid[lat_idx, lon_idx]
    values = data[month_col]
    if np.issubdtype(values.dtype, np.number):
        numeric = pd.to_numeric(values, errors="coerce")
        month = np.where(numeric >= 10000, numeric % 100, numeric).astype(float)
    else:
        parsed = pd.to_datetime(values, errors="coerce")
        month = parsed.dt.month.to_numpy(dtype=float)
    time_months = pd.to_datetime(ceres_ebaf_grid.time.values).month
    output = np.full(len(data), np.nan, dtype=float)
    for i, m in enumerate(month):
        if not np.isfinite(m) or m < 1 or m > 12:
            continue
        month_idx = np.flatnonzero(time_months == int(m))
        if month_idx.size:
            output[i] = ac_values[month_idx[0], lat_idx[i], lon_idx[i]]
    return output
def sensitivity_mean(cot, k, b):
    cot = np.asarray(cot, dtype=float)
    valid = np.isfinite(cot) & (cot > 0)
    if not valid.any():
        return np.nan
    ac = b * cot[valid] ** k / (1.0 + b * cot[valid] ** k)
    return float(np.nanmean(ac * (1.0 - ac)))
def ocean_daytime_albedo(ocean,season,table_folder=SBDART_LUT_FOLDER,max_sza=MAX_SZA):
    """SBDART-derived albedo from the L3 COT/SZA/CER samples.
    COT, SZA and CER are read directly from
    L3_product/{ocean}_{season}.csv; the albedo is looked up from the 3D
    (cot x cer x sza) SBDART LUT.
    """
    file = L3_DIR / f'{ocean}_{season}.csv'
    if not file.exists():
        return None
    data = pd.read_csv(file)
    data = data[['cot','cer','sza']].dropna()
    data = data[
        (data.cot>=MIN_COT)
        &
        (data.cer>0)
        &
        (data.sza>0)
        &
        (data.sza<=max_sza)
    ]
    if len(data)==0:
        return None
    cot = data.cot.to_numpy(float)
    cer = data.cer.to_numpy(float)
    sza = data.sza.to_numpy(float)
    albedo = cot_to_albedo(
        cot,
        'sbdart',
        sza=sza,
        cer=cer,
        table_folder=table_folder,
        ocean=ocean,
        season=season
    )
    return cot,albedo
def bin_relation(cot,albedo,edges):
    labels = pd.cut(
        cot,
        edges,
        labels=False,
        include_lowest=True
    )
    cot_bins = []
    alb_bins = []
    for i in range(len(edges)-1):
        mask = labels==i
        if np.sum(mask)<MIN_GROUP_SIZE:
            continue
        cot_bins.append(
            np.exp(
                np.nanmean(
                    np.log(cot[mask])
                )
            )
        )
        alb_bins.append(
            np.nanmean(albedo[mask])
        )
    return np.asarray(cot_bins),np.asarray(alb_bins)
def _mean_ac_sensitivity(ac):
    """Mean Ac(1-Ac) over the finite Ac samples inside [0, 1]."""
    values = np.asarray(ac, dtype=float)
    values = values[np.isfinite(values) & (values >= 0) & (values <= 1)]
    if not values.size:
        return np.nan
    return float(np.mean(values * (1.0 - values)))
def _mean_ac(ac):
    """Mean Ac over the finite samples inside [0, 1]."""
    values = np.asarray(ac, dtype=float)
    values = values[np.isfinite(values) & (values >= 0) & (values <= 1)]
    if not values.size:
        return np.nan
    return float(np.mean(values))
def mean_ac(cot, k, b):
    """Mean Ac of the relation Ac = b*COT^k / (1 + b*COT^k) over valid COT."""
    cot = np.asarray(cot, dtype=float)
    valid = np.isfinite(cot) & (cot > 0)
    if not valid.any():
        return np.nan
    cot_valid = cot[valid]
    ac = b * cot_valid ** k / (1.0 + b * cot_valid ** k)
    return float(np.nanmean(ac))
def calc_ratio(k, lnb, cot, ceres_ebaf_ac, ceres_ssf_ac_values):
    """Corrected sensitivity divided by six pre-correction baselines.
    Order of the returned ratios: ratio_547, ratio_0,&#x20;
    ratio_ebaf (CERES-EBAF), ratio_ssf (CERES-SSF), ratio_038.
    """
    if not np.isfinite(k) or not np.isfinite(lnb):
        return (np.nan,) * 6
    b_fit = np.exp(lnb)
    corrected = sensitivity_mean(cot, k, b_fit)
    before_547 = sensitivity_mean(cot, 1.0, B_547)
    before_0 = sensitivity_mean(cot, 1.0, B_0)
    before_fixed = AC_FIXED_BEFORE6 * (1.0 - AC_FIXED_BEFORE6)
    ceres_ebaf_sens = _mean_ac_sensitivity(ceres_ebaf_ac)
    ceres_ssf_sens = _mean_ac_sensitivity(ceres_ssf_ac_values)
    return (
        corrected / before_547 if before_547 > 0 else np.nan,
        corrected / before_0 if before_0 > 0 else np.nan,
        corrected / ceres_ebaf_sens if ceres_ebaf_sens > 0 else np.nan,
        corrected / ceres_ssf_sens if ceres_ssf_sens > 0 else np.nan,
        corrected / before_fixed if before_fixed > 0 else np.nan,
    )
def calc_ac_ratio(k, lnb, cot, ceres_ebaf_ac, ceres_ssf_ac_values):
    """Corrected mean Ac divided by the five pre-correction mean-Ac baselines.
    Same baselines and order as calc_ratio, but the ratio is formed from the
    mean cloud albedo Ac itself (not from the sensitivity Ac(1-Ac)).
    Order of the returned ratios: ratio_ac_547, ratio_ac_0,
    ratio_ac_ebaf (CERES-EBAF), ratio_ac_ssf (CERES-SSF), ratio_ac_038.
    """
    if not np.isfinite(k) or not np.isfinite(lnb):
        return (np.nan,) * 5
    b_fit = np.exp(lnb)
    corrected = mean_ac(cot, k, b_fit)
    before_547 = mean_ac(cot, 1.0, B_547)
    before_0 = mean_ac(cot, 1.0, B_0)
    before_fixed = AC_FIXED_BEFORE6
    ceres_ebaf_ac_mean = _mean_ac(ceres_ebaf_ac)
    ceres_ssf_ac_mean = _mean_ac(ceres_ssf_ac_values)
    return (
        corrected / before_547 if before_547 > 0 else np.nan,
        corrected / before_0 if before_0 > 0 else np.nan,
        corrected / ceres_ebaf_ac_mean if ceres_ebaf_ac_mean > 0 else np.nan,
        corrected / ceres_ssf_ac_mean if ceres_ssf_ac_mean > 0 else np.nan,
        corrected / before_fixed if before_fixed > 0 else np.nan,
    )
def accumulate_ac_stats(acc, method, ac):
    """Pool one ocean-season set of Ac samples into the global accumulator."""
    ac = np.asarray(ac, dtype=float)
    ac = ac[np.isfinite(ac) & (ac >= 0) & (ac <= 1)]
    if not ac.size:
        return
    entry = acc.setdefault(method, {"sum_ac": 0.0, "sum_prod": 0.0, "n": 0})
    entry["sum_ac"] += float(np.sum(ac))
    entry["sum_prod"] += float(np.sum(ac * (1.0 - ac)))
    entry["n"] += int(ac.size)
def print_global_ac_stats(acc):
    """Print global-mean Ac and Ac(1-Ac) for every method.
    All valid L3 samples of all ocean-season pairs contribute with equal
    weight, i.e. the statistics are pooled over samples (not averaged over
    the 32 ocean-season means).
    """
    print("\nGlobal-mean Ac and Ac(1-Ac) over all ocean-season samples:")
    for method, label in AC_METHODS:
        entry = acc.get(method)
        if entry is None or entry["n"] == 0:
            print(f"     {method:<10s} ({label}): Ac=nan, Ac(1-Ac)=nan (N=0)")
            continue
        n = entry["n"]
        print(
            f"     {method:<10s} ({label}): "
            f"Ac={entry['sum_ac'] / n:.4f}, "
            f"Ac(1-Ac)={entry['sum_prod'] / n:.4f} (N={n})"
        )
def empty_record(ocean, season):
    """Record of one ocean-season pair with every statistic set to NaN."""
    record = {
        "Ocean": ocean, "Season": season,
        "k_fit": np.nan, "k_fit_std": np.nan,
        "lnb_fit": np.nan, "lnb_fit_std": np.nan,
    }
    for col in RATIO_COLS + AC_RATIO_COLS:
        record[col] = np.nan
    return record
def main():
    ceres_ebaf_grid = load_ceres_ebaf_grid()
    records = []
    ac_stats = {}
    for ocean in oceans:
        for season in SEASONS:
            print(f"Processing {ocean}-{season}")
            file = L3_DIR / f"{ocean}_{season}.csv"
            if not file.exists():
                records.append(empty_record(ocean, season))
                continue
            data = pd.read_csv(file)
            required = {"cot", "cer", "sza", "cf_ceres", "cf_liq_ceres"}
            if not required.issubset(data.columns):
                raise ValueError(f"{file} must contain {sorted(required)}")
            data = data[data.cot >= MIN_COT].copy()
            if data.empty:
                records.append(empty_record(ocean, season))
                continue
            cot = data.cot.to_numpy(float)
            albedo_sbd = cot_to_albedo(
                cot, "sbdart",
                sza=data.sza.to_numpy(float),
                cer=data.cer.to_numpy(float),
                table_folder=SBDART_LUT_FOLDER,
                ocean=ocean, season=season,
            )
            cf_ceres = data.cf_ceres.to_numpy(float)
            cf_liq_ceres = data.cf_liq_ceres.to_numpy(float)
            with np.errstate(divide="ignore", invalid="ignore"):
                cf_liq_frac = np.where(
                    cf_ceres > 0, cf_liq_ceres / cf_ceres, np.nan
                )
            pure_water = np.isfinite(cf_liq_frac) & (cf_liq_frac >= PURE_WATER_FRACTION)
            valid_sbd = np.isfinite(cot) & np.isfinite(albedo_sbd)
            valid_ceres = valid_sbd & pure_water
            cot_sbd = cot[valid_sbd]
            albedo_sbd = np.asarray(albedo_sbd, dtype=float)[valid_sbd]
            cot_bins, alb_bins = bin_relation(cot_sbd, albedo_sbd, COT_EDGES)
            if len(cot_bins) >= 3:
                k_fit, lnb_fit, k_fit_std, lnb_fit_std = fit_cot_albedo(cot_bins, alb_bins)
            else:
                k_fit = lnb_fit = k_fit_std = lnb_fit_std = np.nan
            ceres_ssf_ac_all = ceres_ssf_albedo(data)
            ceres_ssf_ac = ceres_ssf_ac_all[valid_ceres]
            ceres_ebaf_ac_all = match_ceres_ebaf_to_l3(data, ceres_ebaf_grid, season)
            ceres_ebaf_ac = (
                ceres_ebaf_ac_all[valid_ceres]
                if len(ceres_ebaf_ac_all) == len(valid_ceres)
                else ceres_ebaf_ac_all
            )
            ratio_547, ratio_0, ratio_ebaf, ratio_ssf, ratio_038 = calc_ratio(
                k_fit, lnb_fit, cot_sbd, ceres_ebaf_ac, ceres_ssf_ac
            )
            (
                ratio_ac_547, ratio_ac_0, ratio_ac_ebaf,
                ratio_ac_ssf, ratio_ac_038,
            ) = calc_ac_ratio(k_fit, lnb_fit, cot_sbd, ceres_ebaf_ac, ceres_ssf_ac)
            cot_pos = np.asarray(cot_sbd, dtype=float)
            if not cot_pos.size:
                print(f"     [{ocean}-{season}] no valid COT sample, skip Ac statistics")
            ac_samples = {
                "before-1": B_547 * cot_pos / (1.0 + B_547 * cot_pos),
                "before-2": B_0 * cot_pos / (1.0 + B_0 * cot_pos),
                "before-3": ceres_ssf_ac,
                "before-4": ceres_ebaf_ac,
                "before-5": np.full(cot_pos.shape, AC_FIXED_BEFORE6, dtype=float),
            }
            if np.isfinite(k_fit) and np.isfinite(lnb_fit):
                b_fit = float(np.exp(lnb_fit))
                ac_samples["corrected"] = (
                    b_fit * cot_pos**k_fit / (1.0 + b_fit * cot_pos**k_fit)
                )
            for method, ac in ac_samples.items():
                accumulate_ac_stats(ac_stats, method, ac)
            records.append({
                "Ocean": ocean, "Season": season,
                "k_fit": k_fit, "k_fit_std": k_fit_std,
                "lnb_fit": lnb_fit, "lnb_fit_std": lnb_fit_std,
                "b_fit": np.exp(lnb_fit) if np.isfinite(lnb_fit) else np.nan,
                "ratio_547": ratio_547, "ratio_0": ratio_0,
                "ratio_ebaf": ratio_ebaf,
