def bar_shades(color, n, dark_max=0.4, light_max=0.47):
    """Return n opaque shades of *color*, ordered from darker to lighter.
    Instead of stacking transparent (alpha-blended) bars, the lightness of the
    colour itself is changed: the shades left of the centre are darkened
    towards black and the shades right of the centre are blended towards white.
    Using opaque colours keeps the bars flat and print-friendly.
    """
    base = np.asarray(to_rgb(color), dtype=float)
    centre = (n - 2) / 2.0
    shades = []
    for j in range(n):
        t = (j - centre) / centre if centre else 0.0     # -1 (darkest) .. +1 (lightest)
        if t < 0:
            shades.append(tuple(np.clip(base * (1.0 + dark_max * t), 0.0, 1.0)))
        else:
            shades.append(tuple(np.clip(base + (1.0 - base) * light_max * t, 0.0, 1.0)))
    return shades
def draw_ratio_bars(ax, df, ratio_cols, group_centers):
    """Grouped bars: one cluster per ocean, one sub-bar per season x method.
    The colour of each sub-bar is the season colour shaded from darkest
    (leftmost bar) to lightest (rightmost bar).
    """
    season_width = 0.90 / len(SEASONS)
    sub_width = season_width / len(ratio_cols)
    offsets = (np.arange(len(ratio_cols)) - (len(ratio_cols) - 1) / 2) * sub_width
    group_shades = {
        season: bar_shades(SEASON_COLORS[season], len(ratio_cols))
        for season in SEASONS
    }
    for i, season in enumerate(SEASONS):
        season_x = group_centers + (i - (len(SEASONS) - 1) / 2) * season_width
        for j, col in enumerate(ratio_cols):
            vals = []
            for ocean in oceans:
                row = df[(df.Ocean == ocean) & (df.Season == season)].iloc[0]
                vals.append(row[col])
            ax.bar(
                season_x + offsets[j], vals,
                width=sub_width * 0.98,
                color=group_shades[season][j],
                edgecolor=EDGE_COLOR,
                linewidth=EDGE_WIDTH,
                zorder=2,
            )
def add_ratio_legend(ax, ratio_labels, bbox, fontsize=10):
    """Two-row legend without a title: seasons on top, methods below.
    Matplotlib fills legend columns column-major, so the handles are
    interleaved (season, method) and padded with one invisible handle to get
    a seasons row above a methods row.
    """
    from matplotlib.patches import Patch
    season_handles = [
        Patch(facecolor=SEASON_COLORS[season], label=season,
              edgecolor=EDGE_COLOR, linewidth=EDGE_WIDTH)
        for season in SEASONS
    ]
    method_shades = bar_shades("#777777", len(ratio_labels))
    method_handles = [
        Patch(facecolor=method_shades[j], label=ratio_labels[j],
              edgecolor=EDGE_COLOR, linewidth=EDGE_WIDTH)
        for j in range(len(ratio_labels))
    ]
    blank_handle = Patch(facecolor="none", edgecolor="none", label="")
    legend_handles = []
    for j, method_handle in enumerate(method_handles):
        legend_handles.append(
            season_handles[j] if j < len(season_handles) else blank_handle
        )
        legend_handles.append(method_handle)
    ax.legend(handles=legend_handles, ncol=len(method_handles), fontsize=fontsize,
              frameon=False, loc="upper center", bbox_to_anchor=bbox,
              handlelength=1.2, columnspacing=1.4)
